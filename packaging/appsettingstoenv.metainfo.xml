  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Appsettings To Env</name>
  <summary>Convert appsettings.json to environment variables for Docker</summary>
  <description>
    <p>Convert appsettings.json (.NET configuration) into environment variables in KEY=value format, ready for Docker containers.</p>
    <p>Nested keys use __ as separator, arrays are indexed (Key__0, Key__1, ...), and null values are ignored.</p>
    <p>Features: real-time conversion, clipboard copy, save as .env, load from file, light and dark themes.</p>
  </description>
  <launchable type="desktop-id">appsettingstoenv.desktop</launchable>
