import { HorizontalBox, Palette, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";

// Palette: Obsidian Ink #151311, Velvet Curfew #4B262F, Almond Hearth #EED3BA
export global Theme {
    in-out property <ColorScheme> color-scheme: Palette.color-scheme;
    out property <bool> dark: self.color-scheme == ColorScheme.dark;
    out property <brush> background: self.dark ? #151311 : #EED3BA;
    out property <brush> card: self.dark ? #4B262F : #EED3BA.brighter(0.12);
    out property <brush> foreground: self.dark ? #EED3BA : #151311;
    out property <brush> muted: self.dark ? #EED3BA.transparentize(0.35) : #151311.transparentize(0.4);
    out property <brush> border: self.dark ? #EED3BA.transparentize(0.7) : #151311.transparentize(0.8);
    out property <brush> hover: self.dark ? #4B262F.brighter(0.15) : #EED3BA.darker(0.08);
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    animate background { duration: 150ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Theme.foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component OutputPane {
    in property <string> text;
    in property <string> status;
    in property <int> var-count;
    in property <image> action-icon;
    in property <string> action-tip;
    in property <image> save-icon;
    in property <string> save-tip;
    callback action;
    callback save;

    VerticalBox {
        spacing: 4px;
        Text {
            text: "ENV";
            font-size: 13px;
            font-weight: 600;
            color: Theme.muted;
        }
        Rectangle {
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            scroll := ScrollView {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                viewport-width: self.visible-width;
                // viewport = content height; max(visible, preferred) centers the text vertically
                viewport-height: output-text.preferred-height;

                // Native Text: no caret, no focus, read-only by nature; Copy button covers copying
                output-text := Text {
                    text: root.text;
                    font-family: "monospace";
                    font-size: 13px;
                    color: Theme.foreground;
                    wrap: word-wrap;
                    width: scroll.visible-width;
                }
            }
        }
        HorizontalBox {
            spacing: 4px;
            Text {
                text: root.var-count > 0 ? "\{root.var-count} variables" : "";
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            Rectangle { } // spacer: pushes the status and actions to the right
            Text {
                text: root.status;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                visible: root.status != "";
            }
            IconButton {
                icon: root.save-icon;
                tip: root.save-tip;
                clicked => { root.save(); }
            }
            IconButton {
                icon: root.action-icon;
                tip: root.action-tip;
                clicked => { root.action(); }
            }
        }
    }
}

component Pane {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> read-only;
    in property <image> action-icon;
    in property <string> action-tip;
    in property <image> upload-icon;
    in property <string> upload-tip;
    in property <string> status;
    callback text-changed(string);
    callback action;
    callback upload-requested;

    VerticalBox {
        spacing: 4px;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: Theme.muted;
        }
        // TextEdit kept: native placeholder and scrolling beat custom TextInput colors
        TextEdit {
            placeholder-text: root.placeholder;
            read-only: root.read-only;
            text <=> root.text;
            edited(text) => { root.text-changed(text); }
            font-family: "monospace";
            font-size: 13px;
        }
        HorizontalBox {
            spacing: 4px;
            Rectangle { } // spacer: pushes the action to the right
            Text {
                text: root.status;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                visible: root.status != "";
            }
            IconButton {
                icon: root.upload-icon;
                tip: root.upload-tip;
                clicked => { root.upload-requested(); }
            }
            IconButton {
                icon: root.action-icon;
                tip: root.action-tip;
                clicked => { root.action(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Appsettings To Env";
    // Fixed size: min == max locks the window size
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1280px;
    max-width: 1280px;
    min-height: 800px;
    max-height: 800px;
    background: Theme.background;

    in property <string> output;
    in-out property <string> input;
    in property <string> copy-status;
    in property <string> upload-status;
    in property <int> var-count;
    callback input-changed(string);
    callback copy-requested;
    callback save-requested;
    callback clear-requested;
    callback upload-requested;

    VerticalBox {
        spacing: 12px;
        padding: 16px;

        HorizontalBox {
            spacing: 12px;

            Pane {
                label: "appsettings.json";
                placeholder: "Paste your appsettings.json here...";
                text <=> root.input;
                read-only: false;
                action-icon: @image-url("icons/trash.svg");
                action-tip: "Clear";
                upload-icon: @image-url("icons/upload.svg");
                upload-tip: "Load JSON";
                status: root.upload-status;
                text-changed(text) => { root.input-changed(text); }
                action => { root.clear-requested(); }
                upload-requested => { root.upload-requested(); }
            }

            OutputPane {
                text: root.output;
                status: root.copy-status;
                var-count: root.var-count;
                action-icon: @image-url("icons/copy.svg");
                action-tip: "Copy";
                save-icon: @image-url("icons/save.svg");
                save-tip: "Save as .env";
                action => { root.copy-requested(); }
                save => { root.save-requested(); }
            }
        }
    }

    // Theme toggle in the corner; the icon shows the target scheme (dark -> sun, light -> moon)
    IconButton {
        x: root.width - 44px;
        y: 16px;
        icon: Palette.color-scheme == ColorScheme.dark
            ? @image-url("icons/sun.svg")
            : @image-url("icons/moon.svg");
        tip: "Toggle theme";
        clicked => {
            Palette.color-scheme = Palette.color-scheme == ColorScheme.dark
                ? ColorScheme.light
                : ColorScheme.dark;
        }
    }
}
